<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" id="WebApp_ID" version="6.0">
  <display-name>classtask</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.jsp</welcome-file>
    <welcome-file>default.htm</welcome-file>
  </welcome-file-list>
  
  <context-param>
  <param-name>institutename</param-name>
  <param-value>ABC College</param-value>
  </context-param>
  
  <context-param>
  <param-name>maxstudents</param-name>
  <param-value>100</param-value>
  </context-param>
  
  <context-param>
  <param-name>adminemail</param-name>
  <param-value>admin@college.com</param-value>
  </context-param>
  
  
  <servlet>
  <servlet-name>ComputerServlet</servlet-name>
  <servlet-class>classtask.ComputerServlet</servlet-class>
  <init-param>
  <param-name>hodname</param-name>
  <param-value>Dr. Smith</param-value>
  </init-param>
  
  <init-param>
  <param-name>totalcourses</param-name>
  <param-value>12</param-value>
  </init-param>
  </servlet>
  
  <servlet-mapping>
  <servlet-name>ComputerServlet</servlet-name>
  <url-pattern>/ComputerServlet</url-pattern>
  </servlet-mapping>
  
  <servlet>
  <servlet-name>MathServlet</servlet-name>
  <servlet-class>classtask.MathServlet</servlet-class>
  <init-param>
  <param-name>hodname</param-name>
  <param-value>Dr. Johnson</param-value>
  </init-param>
  <init-param>
  <param-name>totalcourses</param-name>
  <param-value>8</param-value>
  </init-param>
  </servlet>
  
  <servlet-mapping>
  <servlet-name>MathServlet</servlet-name>
  <url-pattern>/MathServlet</url-pattern>
  </servlet-mapping>
  
</web-app>